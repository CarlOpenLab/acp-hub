{
  "name": "@cc-heart/acp-hub-conformance",
  "version": "0.0.1",
  "license": "MIT",
  "private": true,
  "description": "Conformance scenarios for acp-hub adapters: one scripted client, identical assertions for every agent",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "acp-hub-conformance": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "selftest": "tsx scripts/selftest.mts"
  },
  "dependencies": {
    "@cc-heart/acp-hub-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
