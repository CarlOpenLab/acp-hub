{
  "name": "@cc-heart/acp-hub-core",
  "version": "0.1.0",
  "license": "MIT",
  "keywords": ["acp","agent-client-protocol","coding-agent","adapter","json-rpc","stdio"],
  "homepage": "https://github.com/CarlOpenLab/acp-hub#readme",
  "bugs": "https://github.com/CarlOpenLab/acp-hub/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CarlOpenLab/acp-hub.git",
    "directory": "packages/core"
  },
  "description": "Unified typed adapter contract and ACP harness for coding agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "cross-spawn": "^7.0.6"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
